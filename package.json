{
  "name": "copilot-portal",
  "type": "module",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-sources.mjs",
    "predev": "npm run sync",
    "dev": "astro dev",
    "dev:api": "npm run build && wrangler pages dev dist",
    "prebuild": "npm run sync",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test src/data/*.test.ts",
    "astro": "astro",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name copilot-portal"
  },
  "dependencies": {
    "@astrojs/react": "5.0.7",
    "astro": "^6.4.8",
    "marked": "^18.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.31"
  },
  "overrides": {
    "vite": "^7.3.7"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7.3.7"
    }
  }
}
