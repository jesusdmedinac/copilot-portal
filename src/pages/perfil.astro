---
import Layout from '../layouts/Layout.astro';
import profile from '../data/profile.json';
import CopyButton from '../components/CopyButton.tsx';

const elevatorPitch = "Senior Mobile Engineer with 10 years of experience architecting high-scale client platforms at Wells Fargo and cross-platform systems in Kotlin Multiplatform (KMP). Creator of json-to-compose and Zora Community, based in San Leandro, CA.";
---

<Layout title="Perfil Técnico y Trayectoria • Copilot Ops">
  <div class="space-y-10 max-w-4xl mx-auto">
    
    <!-- Barra de navegación contextual rápida -->
    <nav class="flex items-center justify-between border-b border-zinc-800 pb-4">
      <a href="/" class="text-xs font-mono text-zinc-400 hover:text-zinc-200 flex items-center gap-1.5 transition-colors">
        ← Volver al Inicio
      </a>
      <div class="flex items-center gap-2">
        <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
          Fuente Verificada: Octubre 2026
        </span>
      </div>
    </nav>

    <!-- Header del Perfil -->
    <section class="p-6 md:p-8 rounded-2xl border border-zinc-800 bg-gradient-to-b from-zinc-900/90 to-zinc-950">
      <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
        <div class="space-y-3">
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-zinc-100">
              {profile.basics.name}
            </h1>
            <span class="px-2.5 py-0.5 rounded text-xs font-mono bg-zinc-800 text-zinc-300 border border-zinc-700">
              10 Años Exp.
            </span>
          </div>

          <p class="text-sm md:text-base font-medium text-indigo-400 font-mono">
            {profile.basics.label}
          </p>

          <p class="text-xs md:text-sm text-zinc-400 leading-relaxed max-w-2xl">
            {profile.basics.summary}
          </p>
        </div>

        <div class="flex flex-col sm:flex-row md:flex-col gap-2 shrink-0">
          <CopyButton 
            client:load 
            text={elevatorPitch} 
            label="Copiar Pitch de 2 líneas" 
          />
          <CopyButton 
            client:load 
            text="https://linkedin.com/in/jesusdmedinac" 
            label="Copiar LinkedIn" 
          />
        </div>
      </div>

      <!-- Badges clave para filtrado rápido de Karla -->
      <div class="mt-6 pt-6 border-t border-zinc-800/80 flex flex-wrap gap-2">
        {profile.keyBadges.map((badge) => (
          <span class="px-2.5 py-1 rounded-lg text-xs font-mono bg-zinc-900 border border-zinc-800 text-zinc-300">
            {badge}
          </span>
        ))}
      </div>
    </section>

    <!-- Sección 1: Rol Actual y Trayectoria Laboral -->
    <section id="trayectoria" class="space-y-6 scroll-mt-20">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-bold text-zinc-100 tracking-tight">Trayectoria Profesional Verificada</h2>
          <p class="text-xs text-zinc-400">Historial verificado sin placeholders temporales ni agencias intermediarias</p>
        </div>
      </div>

      <div class="space-y-4">
        {profile.work.map((job, idx) => {
          const isCurrent = job.endDate === null;
          const cardId = job.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          return (
            <div id={cardId} class={`p-5 md:p-6 rounded-xl border transition-all scroll-mt-24 ${
              isCurrent 
                ? 'border-indigo-500/40 bg-zinc-900/60 shadow-sm shadow-indigo-500/5' 
                : 'border-zinc-800/80 bg-zinc-900/30'
            }`}>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                <div class="flex items-center gap-2.5">
                  <span class="font-bold text-base text-zinc-100">{job.name}</span>
                  {isCurrent && (
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
                      EMPLEO ACTUAL
                    </span>
                  )}
                </div>
                <div class="text-xs font-mono text-zinc-400">
                  {job.startDate} — {isCurrent ? 'Presente' : job.endDate} • {job.location} ({job.location_type})
                </div>
              </div>

              <div class="text-sm font-medium text-zinc-300 mb-2 font-mono">
                {job.position}
              </div>

              <p class="text-xs text-zinc-400 leading-relaxed mb-4">
                {job.summary}
              </p>

              <!-- Responsabilidades clave -->
              <ul class="space-y-2 mb-4 text-xs text-zinc-300">
                {job.highlights && job.highlights.map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="text-indigo-400 font-bold shrink-0">•</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <!-- Skills utilizadas -->
              <div class="flex flex-wrap gap-1.5 pt-3 border-t border-zinc-800/60">
                {job.skills && job.skills.map((skill) => (
                  <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-800/60 text-zinc-400 border border-zinc-700/50">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Sección 2: Proyectos Clave y Código Abierto -->
    <section id="proyectos" class="space-y-6 scroll-mt-20">
      <div>
        <h2 class="text-lg font-bold text-zinc-100 tracking-tight">Proyectos de Autoría y Código Abierto</h2>
        <p class="text-xs text-zinc-400">Pruebas técnicas reales para citar en postulaciones y respuestas</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {profile.projects.map((proj) => (
          <div class="p-5 rounded-xl border border-zinc-800 bg-zinc-900/30 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold text-sm text-zinc-100 font-mono">{proj.name}</span>
                <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-zinc-800 text-zinc-400 border border-zinc-700">
                  {proj.badge}
                </span>
              </div>
              <p class="text-xs text-zinc-400 leading-relaxed mb-4">
                {proj.description}
              </p>
            </div>
            <div class="flex items-center justify-between pt-3 border-t border-zinc-800/60">
              <a 
                href={proj.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-xs font-mono text-indigo-400 hover:text-indigo-300 flex items-center gap-1"
              >
                Ver Repositorio ↗
              </a>
              <CopyButton client:load text={proj.url} label="Copiar URL" />
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Sección 3: Datos de Contacto y Enlaces Oficiales -->
    <section class="p-6 rounded-xl border border-zinc-800 bg-zinc-900/20 space-y-4">
      <h2 class="text-sm font-bold text-zinc-200 tracking-tight font-mono uppercase">
        Enlaces Oficiales para Postulaciones
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {profile.basics.profiles.map((p) => (
          <div class="p-3 rounded-lg border border-zinc-800/80 bg-zinc-900/40 flex items-center justify-between">
            <div>
              <div class="text-[11px] font-mono text-zinc-400">{p.network}</div>
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-zinc-200 hover:underline">
                {p.username}
              </a>
            </div>
            <CopyButton client:load text={p.url} label="Copiar" />
          </div>
        ))}
      </div>
    </section>

  </div>
</Layout>
