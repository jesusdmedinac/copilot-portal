---
import Layout from '../layouts/Layout.astro';
import StatusCard from '../components/StatusCard.tsx';
---

<Layout title="Copilot Ops • Portal de Postulaciones">
  <div class="space-y-8">
    <!-- Hero / Bienvenida para Karla -->
    <section class="p-6 md:p-8 rounded-2xl border border-zinc-800 bg-gradient-to-b from-zinc-900/80 to-zinc-950 shadow-sm">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 mb-4">
        <span>Célula Operativa • San Leandro, CA</span>
      </div>
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-zinc-100">
        Portal Operativo y Base de Conocimiento
      </h1>
      <p class="mt-2 text-zinc-400 text-sm md:text-base leading-relaxed max-w-2xl">
        Espacio centralizado para Karla: consulta de perfil técnico verificado, respuestas oficiales para formularios y asistente para estructuración de postulaciones.
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a 
          href="/perfil"
          class="px-4 py-2 rounded-lg bg-zinc-100 text-zinc-950 font-medium text-xs md:text-sm hover:bg-white transition-colors"
        >
          Explorar Perfil Técnico →
        </a>
        <a 
          href="/guias"
          class="px-4 py-2 rounded-lg bg-zinc-900 border border-zinc-700 text-zinc-300 font-medium text-xs md:text-sm hover:bg-zinc-800 transition-colors"
        >
          Guías y Respuestas →
        </a>
      </div>
    </section>

    <!-- Accesos Directos a Módulos Operativos -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Tarjeta 1: Perfil y Trayectoria -->
      <a 
        href="/perfil" 
        class="group p-5 rounded-xl border border-zinc-800 bg-zinc-900/40 hover:bg-zinc-900/80 hover:border-indigo-500/40 transition-all flex flex-col justify-between"
      >
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-indigo-400 uppercase tracking-wider font-semibold">Módulo 1</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Verificado</span>
          </div>
          <h2 class="text-base font-bold text-zinc-100 group-hover:text-indigo-300 transition-colors">
            Perfil y Trayectoria
          </h2>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Wells Fargo (Senior UI Engineer), 10 años de experiencia, Kotlin Multiplatform, proyectos open source reales y enlaces oficiales.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-zinc-800/60 flex items-center justify-between text-xs font-mono text-zinc-300">
          <span>Consultar timeline</span>
          <span class="text-indigo-400 group-hover:translate-x-0.5 transition-transform">→</span>
        </div>
      </a>

      <!-- Tarjeta 2: Guías y Respuestas -->
      <a 
        href="/guias" 
        class="group p-5 rounded-xl border border-zinc-800 bg-zinc-900/40 hover:bg-zinc-900/80 hover:border-indigo-500/40 transition-all flex flex-col justify-between"
      >
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-indigo-400 uppercase tracking-wider font-semibold">Módulo 2</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-800 text-zinc-400 border border-zinc-700">Respuestas Oficiales</span>
          </div>
          <h2 class="text-base font-bold text-zinc-100 group-hover:text-indigo-300 transition-colors">
            Guías de Redacción y Formularios
          </h2>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Reglas anti-relleno, respuestas oficiales para "Why Us", motivación, liderazgo y botones táctiles de copiado en 1 clic.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-zinc-800/60 flex items-center justify-between text-xs font-mono text-zinc-300">
          <span>Consultar guías</span>
          <span class="text-indigo-400 group-hover:translate-x-0.5 transition-transform">→</span>
        </div>
      </a>
    </section>

    <!-- Módulo interactivo de prueba (Isla de React) -->
    <section class="space-y-3">
      <h2 class="text-xs font-mono uppercase tracking-wider text-zinc-400">Verificación de Integraciones y Rendimiento</h2>
      <StatusCard client:load />
    </section>
  </div>
</Layout>
