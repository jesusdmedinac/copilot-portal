---
import '../styles/global.css';
import CopilotChat from '../components/CopilotChat.tsx';
import PinGate from '../components/PinGate.tsx';
import AuthStatus from '../components/AuthStatus.tsx';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Copilot Ops | Portal Karla", 
  description = "Base de conocimiento y asistente operativo para postulaciones laborales" 
} = Astro.props;

const portalPin = import.meta.env.PORTAL_PIN || "2026";
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-zinc-950 text-zinc-100 flex flex-col min-h-screen">
    <!-- Header de navegación superior -->
    <header class="border-b border-zinc-800/80 bg-zinc-900/60 backdrop-blur sticky top-0 z-50">
      <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <a href="/" class="flex items-center gap-2.5 group">
            <div class="w-8 h-8 rounded-lg bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400 font-mono font-bold text-sm group-hover:border-indigo-400 transition-colors">
              JM
            </div>
            <div>
              <span class="font-semibold text-sm tracking-tight text-zinc-100">Jesús Medina</span>
              <span class="text-xs text-zinc-400 ml-1 font-mono">/ ops</span>
            </div>
          </a>

          <nav class="hidden sm:flex items-center gap-1 font-mono text-xs">
            <a 
              href="/" 
              class="px-3 py-1.5 rounded-lg text-zinc-300 hover:text-zinc-100 hover:bg-zinc-800/60 transition-colors"
            >
              Inicio
            </a>
            <a 
              href="/perfil" 
              class="px-3 py-1.5 rounded-lg text-zinc-300 hover:text-zinc-100 hover:bg-zinc-800/60 transition-colors"
            >
              Perfil y Trayectoria
            </a>
            <a 
              href="/guias" 
              class="px-3 py-1.5 rounded-lg text-zinc-300 hover:text-zinc-100 hover:bg-zinc-800/60 transition-colors"
            >
              Guías y Respuestas
            </a>
          </nav>
        </div>

        <AuthStatus client:load />
      </div>

      <!-- Barra de navegación móvil/tablet inferior en el header -->
      <nav class="sm:hidden flex items-center justify-around border-t border-zinc-800/50 px-2 py-2 font-mono text-xs bg-zinc-900/40">
        <a href="/" class="px-3 py-1 text-zinc-400 hover:text-zinc-100">Inicio</a>
        <a href="/perfil" class="px-3 py-1 text-zinc-400 hover:text-zinc-100">Perfil</a>
        <a href="/guias" class="px-3 py-1 text-zinc-400 hover:text-zinc-100">Guías</a>
      </nav>
    </header>

    <!-- Contenido principal -->
    <main class="flex-1 max-w-5xl w-full mx-auto px-4 py-8">
      <slot />
    </main>

    <!-- Footer sobrio -->
    <footer class="border-t border-zinc-800/60 py-6 text-center text-xs text-zinc-400 font-mono">
      JobSearch Ops • Coordinación Jesús & Karla • Astro 6 + Tailwind
    </footer>

    <!-- Asistente Copilot Flotante para Karla (Isla React) -->
    <CopilotChat client:load />

    <!-- Barrera de Protección por PIN (Isla React con configuración desde .env) -->
    <PinGate pin={portalPin} client:load />
  </body>
</html>
