---
import '../styles/global.css';
import PinGate from '../components/PinGate.tsx';

interface Props {
  title?: string;
  description?: string;
  containerClass?: string;
  isAppView?: boolean;
  hideHeader?: boolean;
}

const { 
  title = "Copilot Ops | Portal Karla", 
  description = "Base de conocimiento y asistente operativo para postulaciones laborales",
  containerClass = "w-full h-full p-0 flex-1 min-h-0",
  isAppView = true,
  hideHeader = true
} = Astro.props;

const portalPin = import.meta.env.PORTAL_PIN || "2026";
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-zinc-950 text-zinc-100 flex flex-col h-[100dvh] overflow-hidden select-none sm:select-auto">
    <!-- Contenido principal (SPA Container) -->
    <main class={`w-full mx-auto flex-1 min-h-0 overflow-hidden flex flex-col ${containerClass}`}>
      <slot />
    </main>

    <!-- Barrera de Protección por PIN (Isla React con configuración desde .env) -->
    <PinGate pin={portalPin} client:load />
  </body>
</html>
